{
  "name": "link-fixer",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "xpi": "npm run zip:firefox && node scripts/make-xpi.mjs",
    "typecheck": "tsc --noEmit",
    "icons:theme": "node scripts/generate-theme-icons.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@wxt-dev/auto-icons": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "wxt": "^0.21.5"
  }
}
